{
  "pattern": "AUTO",
  "notes": "Tax statement (VAT return): legacy build button (تكوين), derived period / company tax data, tax indicator per line, AC_5 recompute, only the last statement may be deleted (with its lines), statement boxes and totals as info values (APP_RULES3_TX, see processes/TX_STAT.md)",
  "rules": {
    "key_expr": {
      "TX_TRNS_DET.DET_SERIAL": "tx_trns_det_seq.nextval"
    },
    "row_rules": {
      "TX_TRNS_MAST": "if inserting then\n  app_rules3_tx.stat_mast_row(:new.company_code, :new.tax_code, :new.tax_no, :new.legal_address, :new.from_date, :new.till_date);\nend if;",
      "TX_TRNS_DET": "app_rules3_tx.stat_det_row(inserting, :new.tax_source, :new.tax_sign, :old.t_tax_flag, :new.t_tax_flag, :old.ac_5, :new.ac_5, :new.tax_value, :new.trns_value);"
    },
    "validations": [
      {
        "name": "الاقرار: تاريخ الاقرار وفترة التقديم وعدم تعديل الشركة والضريبة",
        "plsql": "return app_rules3_tx.stat_check(:PAGE_ROWID, :REQUEST, :PAGE_COMPANY_CODE, :PAGE_TAX_CODE, :PAGE_TRNS_DATE);",
        "when": "CREATE,SAVE"
      }
    ],
    "defaults": {
      "TX_TRNS_MAST.TRNS_DATE": {
        "type": "EXPRESSION",
        "value": "to_char(sysdate, 'DD/MM/YYYY')"
      },
      "TX_TRNS_MAST.TAX_CORR": {
        "type": "STATIC",
        "value": "0"
      },
      "TX_TRNS_MAST.PRE_TAX": {
        "type": "STATIC",
        "value": "0"
      }
    },
    "readonly": [
      "TX_TRNS_MAST.TAX_SERIAL",
      "TX_TRNS_MAST.TAX_NO",
      "TX_TRNS_MAST.LEGAL_ADDRESS",
      "TX_TRNS_MAST.FROM_DATE",
      "TX_TRNS_MAST.TILL_DATE",
      "TX_TRNS_DET.INVOICE_NO",
      "TX_TRNS_DET.TRNS_VALUE",
      "TX_TRNS_DET.TAX_VALUE",
      "TX_TRNS_DET.TRNS_DATE",
      "TX_TRNS_DET.PK1",
      "TX_TRNS_DET.PK2",
      "TX_TRNS_DET.PK3",
      "TX_TRNS_DET.TAX_SOURCE",
      "TX_TRNS_DET.TAX_SIGN"
    ],
    "add_columns": {
