    "columns": {
      "TX_TRNS_MAST.COMPANY_CODE": {
        "readonly_after_insert": true
      },
      "TX_TRNS_MAST.TAX_CODE": {
        "readonly_after_insert": true
      },
      "TX_TRNS_MAST.TRNS_DATE": {
        "readonly_after_insert": true,
        "required": true
      },
      "TX_TRNS_DET.T_TAX_FLAG": {
        "lov": "select r || ' - ' || d d, r from (select 1 r, 'نسبة اساسية' d, 'S' k from dual union all select 2 r, 'مجلس التعاون' d, 'S' k from dual union all select 3 r, 'بدون (صفر بالمائة)' d, 'S' k from dual union all select 4 r, 'صادرات (صفر بالمائة)' d, 'S' k from dual union all select 5 r, 'معفاه' d, 'S' k from dual union all select 6 r, 'نسبة اساسية' d, 'P' k from dual union all select 7 r, 'الاستيرادات التي تدفع في الجمارك' d, 'P' k from dual union all select 8 r, 'الاستيرادات مطبقة عليها الاحتساب العكسي' d, 'P' k from dual union all select 9 r, 'بدون (صفر بالمائة)' d, 'P' k from dual union all select 10 r, 'معفاه' d, 'P' k from dual union all select 0 r, 'معالج حسابات' d, 'X' k from dual) where k = 'X' or (k = 'S' and (:PAGE_TAX_SOURCE in ('CUST', 'SLS') or (:PAGE_TAX_SOURCE = 'ENTRY' and :PAGE_TAX_SIGN = -1))) or (k = 'P' and (:PAGE_TAX_SOURCE in ('SUPP', 'PUR') or (:PAGE_TAX_SOURCE = 'ENTRY' and nvl(:PAGE_TAX_SIGN, 0) != -1))) or (r = 6 and :PAGE_TAX_SOURCE = 'ENTRY' and :PAGE_TAX_SIGN = -1) order by decode(r, 0, 99, r)",
        "widget": "SELECT",
        "cascade": [
          "TAX_SOURCE",
          "TAX_SIGN"
        ],
        "required": true
      },
      "TX_TRNS_DET.TAX_SOURCE": {
        "static": [
          [
            "المبيعات",
            "SLS",
            "Sales"
          ],
          [
            "المشتريات",
            "PUR",
            "Purchases"
          ],
          [
            "العملاء",
            "CUST",
            "Customers"
          ],
          [
            "الموردين",
            "SUPP",
            "Suppliers"
          ],
          [
            "الحسابات",
            "ENTRY",
            "Accounts"
          ]
        ]
      },
      "TX_TRNS_DET.TAX_SIGN": {
        "static": [
          [
            "فاتورة",
            "1",
            "Invoice"
          ],
          [
            "مرتجع",
            "-1",
            "Return"
          ]
        ],
        "label_a": "الإشارة",
        "label_e": "Sign"
      },
      "TX_TRNS_DET.AC_5": {
        "widget": "CHECK",
        "values": [
          "1",
          "0"
        ],
        "label_a": "نسبة 5%",
        "label_e": "5% rate"
      }
    },
    "computed": {
      "TX_TRNS_DET.PER": {
        "sql": "case when nvl(t.trns_value, 1) = 0 then null else round(nvl(t.tax_value, 0) / nvl(t.trns_value, 1) * 100, 0) end",
        "label_a": "نسبة الضريبة %",
        "label_e": "Tax %",
        "type": "NUMBER"
      }
    },
    "blocks": {
      "TX_TRNS_DET": {
        "insert": false,
        "delete": false
      }
    }
  },
  "actions": [
    {
      "name": "BUILD",
      "label_a": "تكوين",
      "label_e": "Build statement",
      "call": "app_rules3_tx.build_statement(:PAGE_ROWID)",
      "message": "app_rules3_tx.last_message",
      "success_a": "تم تكوين الاقرار",
      "success_e": "Statement built",
      "icon": "fa-cogs"
    }
  ]
}
