  "delete": true,
  "notes": "Salesmen file: the legacy blocks SALESMAN, AR_CTGRY_SALESMAN, AR_CUST_SALESMAN, AR_SALESMAN_STORES, AR_SALESMAN_ACCOUNT, AR_SALESMAN_BOOKS(_DET) (the generated AR_SLSMAN_TARGETS grid is not part of the current form); rules in APP_RULES3_AR.",
  "rules": {
    "where": "(nvl(to_number(:G_PASSWORD_NUMBER), 0) = 0 or (CODE >= (select min(FROM_SALESMAN) from AR_CUSTOMER_PASSWORD where PASSWORD_NUMBER = to_number(:G_PASSWORD_NUMBER)) and CODE <= (select max(TO_SALESMAN) from AR_CUSTOMER_PASSWORD where PASSWORD_NUMBER = to_number(:G_PASSWORD_NUMBER))))",
    "key_expr": {
      "AR_CUST_SALESMAN.SALESMAN_CODE": "app_rules3_ar.need_salesman_code",
      "AR_SALESMAN_BOOKS.BOOK_SERIAL": "app_rules3_ar.next_book_serial",
      "AR_SALESMAN_BOOKS_DET.BOOK_NO": "app_rules3_ar.need_num('يجب إدخال رقم السند', 'Enter the receipt number')"
    },
    "hidden": [
      "AR_SALESMAN_STORES.ALT_KEY"
    ],
    "row_rules": {
      "SALESMAN": "if app_rules3_ar.is_form('AR_SALESMAN') then app_rules3_ar.salesman_row(:new.code, :new.disc_ratio, :new.store_code, :new.customer_code, :old.customer_code, :new.users_code, :new.account_no, :new.cost_code1, :new.cost_code2, :new.supervisor_slsman, :new.issue_trns_type, :new.return_trns_type, :new.salesord_trns_type, :new.trnsfr_trns_type, :new.trnsfr_to_trns_type, :new.ar_pay_trns_id, :new.ar_pay_trns_id2, :new.ar_pay_trns_id3, :new.mainarea_id, :new.subarea_id, :new.ctgry_code); end if;",
      "AR_CTGRY_SALESMAN": "app_rules3_ar.ctgry_salesman_row(inserting, :new.salesman_code, :new.ctgry_code);",
      "AR_CUST_SALESMAN": "app_rules3_ar.cust_salesman_row(inserting, :new.customer_code, :new.ctgry_code, :new.salesman_code, :new.credit_limit, :old.salesman_code, :old.ctgry_code, :new.sales_mngr, :new.ctgry_mngr, :new.mrch_slsman);",
      "AR_SALESMAN_STORES": "app_rules3_ar.salesman_store_row(inserting, :new.salesman_id, :new.store_code);",
      "AR_SALESMAN_ACCOUNT": "app_rules3_ar.salesman_account_row(inserting, :new.salesman_id, :new.salesman_account_no, :new.salesman_cost_code, :new.salesman_cost_code2);",
      "AR_SALESMAN_BOOKS": "app_rules3_ar.book_row(inserting, :new.salesman_code, :new.book_serial, :new.from_serial, :new.to_serial, :new.book_type);",
      "AR_SALESMAN_BOOKS_DET": "app_rules3_ar.book_det_row(inserting, :new.salesman_code, :new.book_serial, :new.book_no);"
    },
    "optional": [
      "AR_SALESMAN_BOOKS.BOOK_SERIAL"
    ],
