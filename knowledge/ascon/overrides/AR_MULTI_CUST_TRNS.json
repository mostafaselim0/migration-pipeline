      },
      {
        "name": "DIFF",
        "label_a": "الفرق",
        "label_e": "Difference",
        "sql": "select to_char(nvl(max(total_value), 0) - app_rules3_ar.multi_total(max(serial), 'CUST') - app_rules3_ar.multi_total(max(serial), 'CR'), 'FM999G999G999G990D00') from ar_trns where rowid = chartorowid(:PAGE_ROWID)"
