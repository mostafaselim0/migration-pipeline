{
  "pattern": "MASTER_DETAIL",
  "master": {
    "table": "SUPPLIER",
    "columns": [
      "CODE",
      "NAME_A",
      "NAME_E",
      "SUPPLIER_TYPE",
      "EMP_FLAG",
      "VENDOR_CODE",
      "SUPPLIER_LEVEL",
      "SUPPLIER_STATUS",
      "ADDRESS_A",
      "ADDRESS_E",
      "CONTACT",
      "TELEPHONE1",
      "TELEPHONE2",
      "TELEPHONE3",
      "FAX",
      "E_MAIL",
      "WEB_SITE",
      "MAINAREA_ID",
      "SUBAREA_ID",
      "SUPP_CLASS",
      "ACT_CODE",
      "CURRENCY_CODE",
      "REG_NO",
      "IBAN1",
      "IBAN2",
      "IBAN3",
      "IBAN4",
      "DEBIT_LIMIT",
      "DUE_DAYS",
      "SINGLE_PAY",
      "START_DATE",
      "STOPFLAG",
      "STOPDATE",
      "STOPREASON",
