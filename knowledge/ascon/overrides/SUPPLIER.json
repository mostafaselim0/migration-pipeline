      "COST_NO2",
      "PRODUCT_NAME_A",
      "PRODUCT_NAME_E",
      "BEG_BAL",
      "CRN_BAL_TOTAL"
    ]
  },
  "details": [
    {
      "table": "VN_PAY_METHODE_ACC",
      "join": [
        [
          "SUPPLIER_CODE",
          "CODE"
        ]
      ],
      "title_a": "حسابات طرق الدفع",
      "title_e": "Payment method accounts"
    },
    {
      "table": "VN_SUPP_RESP",
      "join": [
        [
          "SUPP_CODE",
          "CODE"
        ]
      ],
      "title_a": "المسئولين عن المورد",
      "title_e": "Responsibles of supplier"
    },
    {
      "table": "VN_SUPP_KIND",
      "join": [
        [
          "SUPP_CODE",
          "CODE"
        ]
      ],
      "title_a": "ارقام المصنعين",
      "title_e": "Manufacturers"
    },
    {
      "table": "SUPPLIER_SHIPPING_TYPE",
      "join": [
        [
          "SUPPLIER_CODE",
          "CODE"
        ]
      ],
      "title_a": "طرق شحن المورد",
      "title_e": "Shipping methods"
    },
    {
      "table": "SUPPLIER_STAT",
      "join": [
        [
          "SUPPLIER_ID",
          "CODE"
        ]
      ],
      "title_a": "المطابقات",
      "title_e": "Balance reconciliations"
    }
  ],
  "where": null,
  "insert": true,
  "update": true,
  "delete": true,
  "notes": "Suppliers file (live VN\\FMB\\supplier.fmx, 2020, with the supplier code structure): the legacy blocks SUPPLIER, VN_PAY_METHODE_ACC, VN_SUPP_RESP, VN_SUPP_KIND, SUPPLIER_SHIPPING_TYPE, SUPPLIER_STAT; code structure (level, parent, leaf status), telephones, limits, locked currency / activity, delete rules, balances (APP_RULES3_VN).",
  "rules": {
    "where": "nvl(SPPLIER_STATUS, 1) = 1 and (nvl(to_number(:G_PASSWORD_NUMBER), 0) = 0 or (CODE >= (select min(FROM_SUPPLIER_CODE) from VN_SUPPLIER_PASSWORD where PASSWORD_NUMBER = to_number(:G_PASSWORD_NUMBER)) and CODE <= (select max(TO_SUPPLIER_CODE) from VN_SUPPLIER_PASSWORD where PASSWORD_NUMBER = to_number(:G_PASSWORD_NUMBER))))",
    "key_expr": {
      "SUPPLIER.CODE": "app_rules3_vn.need_num('يجب إدخال رقم المورد', 'Enter the supplier code')"
    },
    "row_rules": {
      "SUPPLIER": "if app_rules3_vn.is_form('SUPPLIER') and app_rules3_vn.busy = 0 then\n  app_rules3_vn.supplier_row(inserting, :new.code, :new.supplier_level, :new.supplier_status, case when inserting or app_rules3_vn.chg(:new.telephone1, :old.telephone1) = 1 then :new.telephone1 end, case when inserting or app_rules3_vn.chg(:new.telephone2, :old.telephone2) = 1 then :new.telephone2 end, case when inserting or app_rules3_vn.chg(:new.telephone3, :old.telephone3) = 1 then :new.telephone3 end, case when inserting or app_rules3_vn.chg(:new.fax, :old.fax) = 1 then :new.fax end, case when inserting or app_rules3_vn.chg(:new.debit_limit, :old.debit_limit) = 1 then :new.debit_limit end, case when inserting or app_rules3_vn.chg(:new.due_days, :old.due_days) = 1 then :new.due_days end, :new.stopflag, :new.stopreason, case when inserting or app_rules3_vn.chg(:new.account_no, :old.account_no) = 1 then :new.account_no end, case when inserting or app_rules3_vn.chg(:new.disc_account, :old.disc_account) = 1 then :new.disc_account end, case when inserting or app_rules3_vn.chg(:new.cost_no, :old.cost_no) = 1 then :new.cost_no end, case when inserting or app_rules3_vn.chg(:new.cost_no2, :old.cost_no2) = 1 then :new.cost_no2 end, :new.currency_code, :old.currency_code, :new.act_code, :old.act_code);\nend if;",
      "VN_PAY_METHODE_ACC": "app_rules3_vn.pay_acc_row(:new.settel_type_code, :new.account_no, :new.disc_account, :new.cost_code, :new.cost_code2);",
      "SUPPLIER_STAT": "app_rules3_vn.stat_row(inserting, :new.supplier_id, :new.stat_year, :new.stat_date, :new.sttm_bal, :old.stat_date);"
    },
    "after_save": [
      {
        "name": "المورد الرئيسي (حالة المورد)",
        "plsql": "begin\n  app_rules3_vn.supplier_after(:REQUEST, :PAGE_ROWID, :PAGE_CODE, :PAGE_SUPPLIER_LEVEL);\nend;",
        "when": "CREATE,SAVE,DELETE"
      }
    ],
    "readonly": [
      "SUPPLIER.SUPPLIER_LEVEL",
      "SUPPLIER.SUPPLIER_STATUS",
      "SUPPLIER.BEG_BAL",
      "SUPPLIER.CRN_BAL_TOTAL",
      "SUPPLIER_STAT.STTM_BAL"
    ],
    "optional": [
      "SUPPLIER_STAT.STAT_YEAR"
    ],
    "add_columns": {
      "SUPPLIER.CODE": {
        "label_a": "رقم المورد",
