    "label_e": "Last stage"
   },
   "ST_TRNS_MAST.INV_TIME": {
    "sql": "to_char(t.insert_date, 'HH24:MI')",
    "label_a": "وقت الفاتورة",
    "label_e": "Invoice time"
   },
   "ST_TRNS_MAST.CUST_NAME": {
    "sql": "(select c.old_code || ' - ' || c.name_a || ' / ' || m.name_a || ' - ' || s.name_a from customer c, ar_mainarea m, ar_subarea s where c.code = t.customer_code and m.id (+) = c.mainarea_id and s.main_id (+) = c.mainarea_id and s.id (+) = c.subarea_id)",
    "label_a": "العميل",
    "label_e": "Customer"
   },
   "ST_TRNS_MAST.SLSMAN_NAME": {
    "sql": "(select max(nvl(s.name_a, s.name_e)) from salesman s where s.code = t.salesman_code)",
    "label_a": "اسم المندوب",
    "label_e": "Salesman name"
   },
   "ST_TRNS_MAST.TERMS_NAME": {
    "sql": "(select max(nvl(p.type_name, p.type_name_e)) from st_payment_terms p where p.serial = t.payment_type)",
    "label_a": "بيان شروط الدفع",
    "label_e": "Payment terms name"
   }
