 "details": [],
 "insert": false,
 "update": false,
 "delete": false,
 "notes": "Invoice status monitor (read only): sales invoices (EFFECT 2 / TRNS_TYPE 2, not cancelled) within the user's type, customer and store rights, with the print / preparation / review / delivery-area / driver / driver 2 / customer stage flags; the legacy invoice total, last stage, time, customer / area, salesman and payment terms are computed columns shown on the list and the document (wave 3b; APP_RULES3_SA).",
 "rules": {
  "where": "TRNS_TYPE_CODE IN (SELECT T.TRNS_TYPE_CODE FROM ST_TRNS_TYPE T WHERE T.TRNS_TYPE = 2 AND T.EFFECT = 2) AND NVL(DELETE_FLAG, 0) = 0 AND (NVL(:G_PASSWORD_NUMBER, 0) = 0 OR TRNS_TYPE_CODE IN (SELECT TP.TRNS_TYPE_CODE FROM ST_TRNSTYPE_PASSWORD TP WHERE TP.FLAG = 1 AND TP.PASSWORD_NUMBER = :G_PASSWORD_NUMBER)) AND (NVL(:G_PASSWORD_NUMBER, 0) = 0 OR CUSTOMER_CODE IN (SELECT CP.CUSTOMER_CODE FROM AR_CUST_PASSWORD CP WHERE CP.PASSWORD_NUMBER = :G_PASSWORD_NUMBER)) AND (NVL(:G_PASSWORD_NUMBER, 0) = 0 OR STORE_CODE IN (SELECT SP.STORE_CODE FROM ST_STORE_PASSWORD SP WHERE SP.FLAG = 1 AND SP.PASSWORD_NUMBER = :G_PASSWORD_NUMBER))",
