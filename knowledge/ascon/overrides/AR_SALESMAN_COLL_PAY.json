      },
      "AR_SLS_COLL_DET.AR_SUBAREA_ID": {
        "label_a": "الفــرع",
        "label_e": "Branch"
      },
      "AR_SLS_COLL_DET.AR_TRNS_SERIAL": {
        "label_a": "مسلسل الحركة",
        "label_e": "Transaction serial"
      },
      "AR_SLS_COLL_DET.AR_DOC_NO": {
        "label_a": "رقم المستند",
        "label_e": "Document no."
      },
      "AR_SLS_COLL_DET.RP_TRNS_ID": {
        "label_a": "نوع حركة القبض",
        "label_e": "Receipt type"
      },
      "AR_SLS_COLL_DET.RP_TRNS_SERIAL": {
        "label_a": "مسلسل سند القبض",
        "label_e": "Receipt serial"
      },
      "AR_SLS_COLL_DET.RP_DOC_NO": {
        "label_a": "رقم سند القبض",
        "label_e": "Receipt no."
      },
      "AR_SLS_COLL_DET.TRNS_VALUE": {
        "label_a": "اجمالى الحركة / مبلغ الخصم من السند",
        "label_e": "Value"
      },
      "AR_SLS_COLL_DET.CHOOSE_FLAG": {
