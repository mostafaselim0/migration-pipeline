      },
      "AR_SLS_COLL_TRNSFER.DET_SERIAL": {
        "label_a": "مسلسل",
        "label_e": "Serial"
      },
      "AR_SLS_COLL_TRNSFER.MOB_TRNS_SEQ": {
        "label_a": "مسلسل الحركة",
        "label_e": "Deposit no."
      },
      "AR_SLS_COLL_TRNSFER.MOB_TRNS_DATE": {
