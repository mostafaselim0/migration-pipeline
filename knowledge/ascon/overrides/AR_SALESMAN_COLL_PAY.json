      },
      "AR_SLS_COLL_TRNSFER.MOB_TRNS_VALUE": {
        "label_a": "مبلغ الخصم من السند",
        "label_e": "Value"
      },
      "AR_SLS_COLL_TRNSFER.MOB_BANK_CODE": {
        "label_a": "رقم البنك",
        "label_e": "Bank"
      },
      "AR_SLS_COLL_TRNSFER.MOB_BRANCH_CODE": {
        "label_a": "رقم الفرع",
        "label_e": "Branch"
      },
      "AR_SLS_COLL_TRNSFER.MOB_PAY_TYPE": {
        "label_a": "نوع السداد (0 نقدى / 1 شيكات / 2 حوالات)",
        "label_e": "Pay type (0 cash / 1 cheque / 2 transfer)"
      }
    },
    "info": [
      {
        "name": "AR",
        "label_a": "إجمالى قيمة الحركات المختارة",
        "label_e": "Chosen payments",
        "sql": "select to_char(app_rules3_ar.coll_total(to_number(:PAGE_SALESMAN_ID), to_number(:PAGE_SERIAL), 'AR'), 'FM999G999G999G990D00') from dual"
      },
      {
        "name": "ARN",
        "label_a": "إجمالى عدد الحركات المختارة",
        "label_e": "Chosen payments count",
        "sql": "select to_char(app_rules3_ar.coll_total(to_number(:PAGE_SALESMAN_ID), to_number(:PAGE_SERIAL), 'ARN'), 'FM999G999G999G990D00') from dual"
      },
      {
        "name": "RP",
        "label_a": "إجمالى قيمة سندات القبض",
        "label_e": "Cash-box receipts",
        "sql": "select to_char(app_rules3_ar.coll_total(to_number(:PAGE_SALESMAN_ID), to_number(:PAGE_SERIAL), 'RP'), 'FM999G999G999G990D00') from dual"
      },
      {
        "name": "TRF",
        "label_a": "إجمالى قيمة الايداعات البنكية",
        "label_e": "Bank deposits",
        "sql": "select to_char(app_rules3_ar.coll_total(to_number(:PAGE_SALESMAN_ID), to_number(:PAGE_SERIAL), 'TRF'), 'FM999G999G999G990D00') from dual"
      }
    ]
  },
  "actions": [
    {
      "name": "LOAD_AR",
      "label_a": "انزال سدادات العملاء",
      "label_e": "Load customer payments",
      "confirm_a": "هل تريد انزال سدادات العملاء النقدية غير المربوطة للمندوب؟",
      "confirm_e": "Load the salesman's unlinked cash customer payments?",
      "call": "app_rules3_ar.coll_load_ar(:PAGE_ROWID)",
      "success_a": "تم انزال سدادات العملاء",
      "success_e": "Customer payments loaded",
      "icon": "fa-download"
    },
    {
      "name": "LOAD_RP",
      "label_a": "انزال سندات القبض",
      "label_e": "Load cash-box receipts",
      "confirm_a": "هل تريد انزال سندات قبض الصناديق المتبقية للمندوب؟",
      "confirm_e": "Load the salesman's remaining cash-box receipts?",
      "call": "app_rules3_ar.coll_load_rp(:PAGE_ROWID)",
      "success_a": "تم انزال سندات القبض",
      "success_e": "Receipts loaded",
      "icon": "fa-download"
    },
    {
      "name": "LOAD_MOB",
      "label_a": "انزال الايداعات البنكية",
      "label_e": "Load bank deposits",
      "confirm_a": "هل تريد انزال الايداعات البنكية المعتمدة المتبقية للمندوب؟",
      "confirm_e": "Load the salesman's remaining approved bank deposits?",
      "call": "app_rules3_ar.coll_load_mob(:PAGE_ROWID)",
      "success_a": "تم انزال الايداعات البنكية",
      "success_e": "Bank deposits loaded",
      "icon": "fa-download"
    }
  ]
}
