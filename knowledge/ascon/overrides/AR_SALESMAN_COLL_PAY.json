      "AR_SLS_COLL_MAST.NOTES": {
        "label_a": "البيان",
        "label_e": "Description"
      },
      "AR_SLS_COLL_MAST.REMARKS": {
        "label_a": "ملاحظات",
        "label_e": "Remarks"
      },
      "AR_SLS_COLL_DET.AR_FLAG": {
        "label_a": "النوع (1 سداد عميل / 0 سند قبض)",
        "label_e": "Type (1 customer payment / 0 receipt)"
      },
      "AR_SLS_COLL_DET.DET_SERIAL": {
        "label_a": "مسلسل",
        "label_e": "Serial"
      },
      "AR_SLS_COLL_DET.AR_TRNS_ID": {
