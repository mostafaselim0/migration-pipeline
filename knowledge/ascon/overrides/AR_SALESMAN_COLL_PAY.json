{
  "pattern": "MASTER_DETAIL",
  "master": {
    "table": "AR_SLS_COLL_MAST"
  },
  "details": [
    {
      "table": "AR_SLS_COLL_DET",
      "join": [
        [
          "SERIAL",
          "SERIAL"
        ],
        [
          "SALESMAN_ID",
          "SALESMAN_ID"
        ]
      ],
      "title_a": "سدادات العملاء (1) وسندات القبض (0)",
      "title_e": "Customer payments (1) and cash-box receipts (0)"
    },
    {
      "table": "AR_SLS_COLL_TRNSFER",
      "join": [
        [
          "SERIAL",
          "SERIAL"
        ],
        [
          "SALESMAN_ID",
          "SALESMAN_ID"
        ]
      ],
      "title_a": "حركات الايداعات البنكية للمندوب",
      "title_e": "Salesman bank deposits"
    }
  ],
  "where": null,
  "insert": true,
  "update": true,
  "delete": true,
  "notes": "Linking the salesmen's collections (customer payments collected by mobile) with the cash-box receipts and bank deposits (AR_SLS_COLL_MAST / _DET / _TRNSFER); three load buttons and the balance check; the generated grid on AR_SALESMAN_PASSWORD was corrected; rules in APP_RULES3_AR.",
  "rules": {
    "where": "(nvl(to_number(:G_PASSWORD_NUMBER), 0) = 0 or SALESMAN_ID in (select SALESMAN_CODE from AR_SALESMAN_PASSWORD where PASSWORD_NUMBER = to_number(:G_PASSWORD_NUMBER)))",
    "key_expr": {
      "AR_SLS_COLL_MAST.SERIAL": "app_rules3_ar.next_coll_serial(:new.salesman_id)",
      "AR_SLS_COLL_MAST.SALESMAN_ID": "app_rules3_ar.need_num('يجب إدخال المندوب', 'Enter the salesman')"
    },
    "row_rules": {
      "AR_SLS_COLL_MAST": "app_rules3_ar.coll_mast_row(inserting, :new.salesman_id, :new.trns_date, :old.trns_date, :new.doc_no, :new.notes);",
      "AR_SLS_COLL_DET": "app_rules3_ar.coll_det_row(inserting, :new.salesman_id, :new.serial, :new.ar_flag, :new.ar_trns_id, :new.ar_mainarea_id, :new.ar_subarea_id, :new.ar_trns_serial, :new.rp_trns_id, :new.rp_trns_serial, :new.choose_flag, :old.choose_flag, :new.trns_value, :new.ar_doc_no, :new.rp_doc_no);",
      "AR_SLS_COLL_TRNSFER": "app_rules3_ar.coll_trf_row(inserting, :new.salesman_id, :new.serial, :new.mob_trns_seq, :new.mob_trns_value, :new.mob_trns_date, :new.mob_bank_code, :new.mob_branch_code, :new.mob_pay_type);"
    },
    "after_save": [
      {
        "name": "الحركة غير متوازنة",
        "plsql": "begin\n  app_rules3_ar.coll_balance(:PAGE_ROWID);\nend;",
        "when": "CREATE,SAVE"
      }
    ],
    "defaults": {
      "AR_SLS_COLL_MAST.TRNS_DATE": {
        "type": "EXPRESSION",
        "value": "to_char(sysdate, 'DD/MM/YYYY')"
      },
      "AR_SLS_COLL_DET.AR_FLAG": {
        "type": "STATIC",
        "value": "1"
      },
      "AR_SLS_COLL_DET.CHOOSE_FLAG": {
        "type": "STATIC",
        "value": "0"
      }
    },
    "columns": {
      "AR_SLS_COLL_MAST.SALESMAN_ID": {
        "lov": "select code || ' - ' || name_a d, code r from salesman where (nvl(to_number(:G_PASSWORD_NUMBER), 0) = 0 or code in (select salesman_code from ar_salesman_password where password_number = to_number(:G_PASSWORD_NUMBER))) order by 2",
        "readonly_after_insert": true
      },
      "AR_SLS_COLL_DET.AR_FLAG": {
        "static": [
          [
            "سداد عميل",
            "1"
          ],
          [
            "سند قبض",
            "0"
          ]
        ],
        "readonly_after_insert": true
      },
      "AR_SLS_COLL_DET.CHOOSE_FLAG": {
        "widget": "CHECK",
        "values": [
          "1",
          "0"
        ]
      }
    },
    "optional": [
      "AR_SLS_COLL_MAST.SERIAL",
      "AR_SLS_COLL_DET.DET_SERIAL",
      "AR_SLS_COLL_TRNSFER.DET_SERIAL"
    ],
    "readonly": [
      "AR_SLS_COLL_MAST.SERIAL",
      "AR_SLS_COLL_DET.DET_SERIAL",
      "AR_SLS_COLL_DET.AR_DOC_NO",
      "AR_SLS_COLL_DET.RP_DOC_NO",
      "AR_SLS_COLL_TRNSFER.DET_SERIAL",
      "AR_SLS_COLL_TRNSFER.MOB_TRNS_DATE",
      "AR_SLS_COLL_TRNSFER.MOB_BANK_CODE",
      "AR_SLS_COLL_TRNSFER.MOB_BRANCH_CODE",
      "AR_SLS_COLL_TRNSFER.MOB_PAY_TYPE"
    ],
    "add_columns": {
      "AR_SLS_COLL_MAST.SERIAL": {
        "label_a": "مسلسل",
        "label_e": "Serial"
      },
      "AR_SLS_COLL_MAST.SALESMAN_ID": {
        "label_a": "المندوب",
        "label_e": "Salesman"
      },
      "AR_SLS_COLL_MAST.TRNS_DATE": {
        "label_a": "تاريخ الحركة",
        "label_e": "Date"
      },
      "AR_SLS_COLL_MAST.DOC_NO": {
        "label_a": "رقم المستند",
        "label_e": "Document no."
