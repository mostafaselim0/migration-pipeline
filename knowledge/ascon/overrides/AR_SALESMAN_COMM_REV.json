    {
      "table": "AR_COMM_PAY",
      "join": [
        [
          "SALESMAN_CODE",
          "CODE"
        ]
      ],
      "title_a": "تفاصيل الفواتير المسددة",
      "title_e": "Paid invoices"
    },
    {
      "table": "AR_COMM_SALES",
