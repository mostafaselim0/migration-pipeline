  "actions": [
    {
      "name": "CALC",
      "label_a": "إحتساب العمولة",
      "label_e": "Calculate commission",
      "confirm_a": "هل تريد إحتساب عمولة المندوب للشهر المختار؟",
      "confirm_e": "Calculate the salesman's commission for the month?",
      "params": [
        {
          "name": "COMM_MONTH",
          "label_a": "الشهر",
          "label_e": "Month",
          "type": "number",
          "required": true,
          "default": "to_number(to_char(sysdate, 'MM'))",
          "default_type": "EXPRESSION"
        },
        {
          "name": "COMM_YEAR",
          "label_a": "السنة",
          "label_e": "Year",
          "type": "number",
          "required": true,
          "default": "to_number(to_char(sysdate, 'YYYY'))",
          "default_type": "EXPRESSION"
        }
      ],
      "call": "app_rules3_ar.comm_calc(:PAGE_ROWID, :COMM_MONTH, :COMM_YEAR)",
      "success_a": "تم إحتساب العمولة",
      "success_e": "Commission calculated",
      "icon": "fa-calculator"
    },
    {
      "name": "DELETE_COMM",
      "label_a": "حذف العمولة",
      "label_e": "Delete commission",
      "confirm_a": "هل تريد مسح عمولة المندوب للشهر المختار؟",
      "confirm_e": "Do you want to delete the salesman's commission of the month?",
      "params": [
        {
          "name": "COMM_MONTH",
          "label_a": "الشهر",
          "label_e": "Month",
          "type": "number",
          "required": true,
          "default": "to_number(to_char(sysdate, 'MM'))",
          "default_type": "EXPRESSION"
        },
        {
          "name": "COMM_YEAR",
          "label_a": "السنة",
          "label_e": "Year",
          "type": "number",
          "required": true,
          "default": "to_number(to_char(sysdate, 'YYYY'))",
          "default_type": "EXPRESSION"
        }
      ],
      "call": "app_rules3_ar.comm_delete(:PAGE_ROWID, :COMM_MONTH, :COMM_YEAR)",
