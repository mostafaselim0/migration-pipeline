        "label_e": "Percent"
      }
    }
  },
  "actions": [
    {
      "name": "LOAD_ITEMS",
      "label_a": "انزال الاصناف",
      "label_e": "Load items",
      "confirm_a": "هل تريد انزال الأصناف المختارة إلى عمولات الأصناف للمدى؟",
      "confirm_e": "Load the selected items into the range item commissions?",
      "params": [
        {
          "name": "SERIAL",
          "label_a": "مسلسل المدى",
          "label_e": "Range serial",
          "type": "number",
          "required": true
        },
        {
          "name": "DISC_FLAG",
          "label_a": "حالة الخصم (0 بدون / 1 بالخصم)",
          "label_e": "Discount flag (0 / 1)",
          "type": "number",
          "required": true,
          "default": "0"
        },
        {
          "name": "FROM_GROUP",
          "label_a": "من مجموعة",
          "label_e": "From group",
          "type": "number"
        },
        {
          "name": "TO_GROUP",
          "label_a": "إلى مجموعة",
          "label_e": "To group",
          "type": "number"
        },
        {
          "name": "FROM_ITEM",
          "label_a": "من صنف",
          "label_e": "From item",
          "type": "text"
        },
        {
          "name": "TO_ITEM",
          "label_a": "إلى صنف",
          "label_e": "To item",
          "type": "text"
        },
        {
          "name": "FROM_SUPP",
          "label_a": "من مورد",
          "label_e": "From supplier",
          "type": "number"
        },
        {
          "name": "TO_SUPP",
          "label_a": "إلى مورد",
          "label_e": "To supplier",
          "type": "number"
        },
        {
          "name": "FROM_KIND",
          "label_a": "من مصنع",
          "label_e": "From kind",
          "type": "number"
        },
        {
          "name": "TO_KIND",
          "label_a": "إلى مصنع",
          "label_e": "To kind",
          "type": "number"
        }
      ],
      "call": "app_rules3_ar.load_comm_items(to_number(:PAGE_CATEGORY_TYPE_CODE), :SERIAL, :DISC_FLAG, :FROM_GROUP, :TO_GROUP, :FROM_ITEM, :TO_ITEM, :FROM_SUPP, :TO_SUPP, :FROM_KIND, :TO_KIND)",
      "success_a": "تم انزال الاصناف",
      "success_e": "Items loaded",
      "icon": "fa-download"
    }
  ]
}
