{
  "pattern": "MASTER_DETAIL",
  "master": {
    "table": "ST_CATEGORY_TYPE"
  },
  "details": [
    {
      "table": "ST_CATEGORY_COMM",
      "join": [
        [
          "CATEGORY_TYPE_CODE",
          "CATEGORY_TYPE_CODE"
        ]
      ],
      "title_a": "مدى المستهدف والعمولات المناظرة (حالة الخصم: 0 بدون الخصم / 1 بالخصم)",
      "title_e": "Target ranges and commissions (DISC_FLAG 0 = without discount, 1 = with discount)"
    },
    {
      "table": "ST_CATEGORY_COMM_ITEMS",
      "join": [
        [
          "CATEGORY_TYPE_CODE",
          "CATEGORY_TYPE_CODE"
        ]
      ],
      "title_a": "عمولات الاصناف",
      "title_e": "Item commissions"
    },
    {
      "table": "ST_CATEGORY_COMM_MNGR",
      "join": [
        [
          "CATEGORY_TYPE_CODE",
          "CATEGORY_TYPE_CODE"
        ]
      ],
      "title_a": "مدى المستهدف وعمولات المدير",
      "title_e": "Target ranges and commissions (manager)"
    },
    {
      "table": "AR_SALESMAN_COMM",
      "join": [
        [
          "CTGRY_CODE",
          "CATEGORY_TYPE_CODE"
        ]
      ],
      "title_a": "المستهدف للمندوبين",
      "title_e": "Salesmen targets"
    },
    {
      "table": "AR_SALESMAN_PRC_COMM",
      "join": [
        [
          "CTGRY_CODE",
          "CATEGORY_TYPE_CODE"
        ]
      ],
      "title_a": "عمولات المستهدف للمندوبين",
      "title_e": "Salesmen target commissions"
    }
  ],
  "where": null,
  "insert": true,
  "update": true,
  "delete": true,
  "notes": "Department (ST_CATEGORY_TYPE) commission setup; wave 3: range numbering / continuity / last-serial delete, salesman of the department, item-commission loader (APP_RULES3_AR).",
  "rules": {
    "key_expr": {
      "ST_CATEGORY_COMM.SERIAL": "app_rules3_ar.next_comm_serial('COMM', :new.category_type_code, :new.disc_flag)",
      "ST_CATEGORY_COMM_MNGR.SERIAL": "app_rules3_ar.next_comm_serial('MNGR', :new.category_type_code, :new.disc_flag)",
      "AR_SALESMAN_PRC_COMM.SERIAL": "app_rules3_ar.next_comm_serial('PRC', :new.ctgry_code, null)"
    },
    "row_rules": {
      "ST_CATEGORY_COMM": "app_rules3_ar.comm_row('COMM', inserting, :new.category_type_code, :new.disc_flag, :new.serial, :new.from_p, :new.to_p);",
      "ST_CATEGORY_COMM_MNGR": "app_rules3_ar.comm_row('MNGR', inserting, :new.category_type_code, :new.disc_flag, :new.serial, :new.from_p, :new.to_p);",
      "AR_SALESMAN_PRC_COMM": "app_rules3_ar.comm_row('PRC', inserting, :new.ctgry_code, null, :new.serial, :new.from_p, :new.to_p, :new.code);",
      "ST_CATEGORY_COMM_ITEMS": "app_rules3_ar.comm_items_row(:new.category_type_code, :new.serial, :new.disc_flag, :new.group_code, :new.item_code);",
      "AR_SALESMAN_COMM": "app_rules3_ar.salesman_comm_row(:new.code, :new.ctgry_code);"
    },
    "defaults": {
      "ST_CATEGORY_COMM.DISC_FLAG": {
        "type": "STATIC",
        "value": "0"
      },
      "ST_CATEGORY_COMM_MNGR.DISC_FLAG": {
        "type": "STATIC",
        "value": "0"
      },
      "ST_CATEGORY_COMM_ITEMS.DISC_FLAG": {
        "type": "STATIC",
        "value": "0"
      }
    },
    "readonly": [
      "ST_CATEGORY_COMM.FROM_P",
      "ST_CATEGORY_COMM_MNGR.FROM_P",
      "AR_SALESMAN_PRC_COMM.FROM_P"
    ],
    "optional": [
      "ST_CATEGORY_COMM.SERIAL",
      "ST_CATEGORY_COMM_MNGR.SERIAL",
      "ST_CATEGORY_COMM_ITEMS.GROUP_CODE"
    ],
    "add_columns": {
      "ST_CATEGORY_TYPE.CUST_AGE": {
