      },
      "ST_CATEGORY_COMM_ITEMS.COMM": {
        "label_a": "نسبة التحصيل",
        "label_e": "Collection %"
      },
      "ST_CATEGORY_COMM_ITEMS.SALES_COMM": {
        "label_a": "نسبة البيع",
        "label_e": "Sales %"
      },
      "AR_SALESMAN_COMM.CODE": {
        "label_a": "كود المندوب",
