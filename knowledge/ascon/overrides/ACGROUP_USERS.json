  "actions": [
    {
      "name": "COPY_RIGHTS",
      "label_a": "نسخ صلاحيات",
      "label_e": "Copy privileges",
      "confirm_a": "سيتم استبدال مجموعات وأنظمة وصلاحيات شاشات وتقارير هذا المستخدم بصلاحيات المستخدم المختار. هل تريد الاستمرار؟",
      "confirm_e": "The groups, systems, screen and report rights of this user will be replaced by those of the chosen user. Continue?",
      "params": [
        {
          "name": "FROM_USER",
          "label_a": "من مستخدم",
          "label_e": "From user",
          "type": "number",
          "required": true,
          "lov_sql": "select users_code || ' - ' || nvl(users_name, users_name_e) d, users_code r from users where users_code <> to_number(:PAGE_USERS_CODE) order by users_code"
        }
      ],
      "call": "app_rules3_se.copy_user_rights(:PAGE_ROWID, :FROM_USER)",
      "message": "app_rules3_se.last_message",
      "success_a": "التم نسخ صلاحية المستخدم",
      "success_e": "Users Previlage Copy Complete",
      "icon": "fa-copy"
    },
    {
      "name": "ALL_GROUPS",
      "label_a": "جميع المجموعات",
      "label_e": "All groups",
      "call": "app_rules3_se.all_groups(:PAGE_ROWID)",
      "message": "app_rules3_se.last_message",
      "success_a": "تمت إضافة المجموعات",
      "success_e": "Groups added",
      "icon": "fa-users"
    },
    {
      "name": "ZERO_PASSWORD",
      "label_a": "تصفير كلمة السر",
      "label_e": "Zero password",
      "confirm_a": "هل تريد تصفير كلمة السر لهذا المستخدم؟",
      "confirm_e": "Reset the password of this user to 0?",
      "call": "app_rules3_se.zero_password(:PAGE_ROWID)",
      "message": "app_rules3_se.last_message",
      "success_a": "تم تصفير كلمة السر",
      "success_e": "Password reset",
      "icon": "fa-key"
    }
