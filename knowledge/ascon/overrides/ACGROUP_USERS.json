{
  "pattern": "MASTER_DETAIL",
  "master": {
    "table": "USERS"
  },
  "details": [
    {
      "table": "GROUP_USERS",
      "join": [
        [
          "USERS_CODE",
          "USERS_CODE"
        ]
      ],
      "title_a": "المجموعات",
      "title_e": "Groups"
    },
    {
      "table": "SE_USERS_ROLES",
      "join": [
        [
          "USERS_CODE",
          "USERS_CODE"
        ]
      ],
      "title_a": "الادوار",
      "title_e": "Roles"
    },
    {
      "table": "SE_USERS_NOTIFICATION",
      "join": [
        [
          "USERS_CODE",
          "USERS_CODE"
        ]
      ],
      "title_a": "التنبيهات",
      "title_e": "Notifications"
    }
  ],
  "insert": true,
  "update": true,
  "delete": true,
  "notes": "Users (USERS) with their groups, roles and notifications; legacy password encoding + APEX one-time password, one default group, copy rights / all groups / zero password buttons, user 0 protected (APP_RULES3_SE, see processes/ACGROUP_USERS.md)",
  "rules": {
    "where": "(USERS_CODE = to_number(:G_USER_CODE) or nvl(to_number(:G_PASSWORD_NUMBER), 0) = 0)",
    "key_expr": {
      "SE_USERS_ROLES.ROLE_ID": "app_rules3_se.required('رقم الدور', 'Role')",
      "SE_USERS_NOTIFICATION.NOTIF_ID": "app_rules3_se.required('رقم التنبيه', 'Notification')"
    },
    "row_rules": {
      "USERS": "app_rules3_se.users_row(inserting, :new.users_code, :old.password, :new.password, :new.lang_flag);",
      "GROUP_USERS": "app_rules3_se.group_users_row(inserting, :new.users_code, :new.password_number, :new.isdefault);"
    },
    "after_save": [
      {
        "name": "مجموعة أساسية واحدة للمستخدم",
        "plsql": "declare\n  l number;\nbegin\n  select users_code into l from users where rowid = chartorowid(:PAGE_ROWID);\n  app_rules3_se.fix_default_group(l);\nend;",
        "when": "CREATE,SAVE"
      }
    ],
    "readonly": [
      "USERS.CHANGE_TIME"
    ],
    "add_columns": {
