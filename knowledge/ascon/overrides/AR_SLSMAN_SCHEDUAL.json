        "label_a": "ناجحة",
        "label_e": "Successful"
      }
    }
  },
  "actions": [
    {
      "name": "LOAD_ROUTE",
      "label_a": "خط السير",
      "label_e": "Load route",
      "confirm_a": "هل تريد جدولة زيارات عملاء خط السير لهذا اليوم؟",
      "confirm_e": "Schedule the visits of the route customers for this day?",
      "params": [
        {
          "name": "GROUP_ID",
          "label_a": "رقم خط السير",
          "label_e": "Route",
          "type": "number",
          "required": true,
          "lov_sql": "select group_id || ' - ' || group_desc d, group_id r from ar_customer_group_mast where salesman_id = to_number(:PAGE_CODE) order by group_id"
        },
        {
          "name": "VISIT_DATE",
          "label_a": "التاريخ",
          "label_e": "Date",
          "type": "date",
          "required": true,
          "default": "to_char(sysdate + 1, 'DD/MM/YYYY')",
          "default_type": "EXPRESSION"
        }
      ],
      "call": "app_rules3_ar.load_route(:PAGE_ROWID, :GROUP_ID, :VISIT_DATE)",
      "success_a": "تمت جدولة زيارات خط السير",
      "success_e": "Route visits scheduled",
      "icon": "fa-map-marker"
    }
  ]
}
