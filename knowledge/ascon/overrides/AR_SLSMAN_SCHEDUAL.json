        "label_a": "نهاية",
        "label_e": "End"
      },
      "AR_SALESMAN_VISITS.SALES_FLAG": {
        "label_a": "مبيعات",
        "label_e": "Sales"
      },
      "AR_SALESMAN_VISITS.SALES_DESC": {
        "label_a": "وصف المبيعات",
        "label_e": "Sales remarks"
      },
      "AR_SALESMAN_VISITS.COL_FLAG": {
        "label_a": "تحصيل",
        "label_e": "Collection"
      },
      "AR_SALESMAN_VISITS.COL_DESC": {
        "label_a": "وصف التحصيل",
        "label_e": "Collection remarks"
      },
      "AR_SALESMAN_VISITS.RET_FLAG": {
        "label_a": "مرتجع",
        "label_e": "Return"
      },
