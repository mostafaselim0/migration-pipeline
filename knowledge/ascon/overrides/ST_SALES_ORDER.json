{
  "pattern": "AUTO",
  "notes": "Sales orders (ST_SALES_ORDER, types EFFECT 7 / TRNS_TYPE 30): legacy numbering, customer/salesman/date/duplicate checks, approval 1/2 permissions and order, lock after invoicing, line policy prices (CALC_SALES_DISC), lots with stock, VAT (APP_RULES_SA); wave 3 (APP_ACT_ST): close / reopen / cancel / activate buttons, DEVIDE_CONFGS lot split, delete refused once invoiced, credit and PO-date warnings, credit / totals / counters displays",
  "rules": {
  "computed": {
   "ST_SALES_ORDER_DET.ITEM_NAME": {"sql": "(select max(nvl(i.name_e, i.name_a)) from st_item i where i.item_code = t.item_code)", "label_a": "إســم الصنـــف", "label_e": "Item Name"},
   "ST_SALES_ORDER_DET.LOT_NUMBER": {"sql": "(select max(c.lot_number) from st_item_confg c where c.item_confg_id = t.item_confg_id)", "label_a": "Btch #", "label_e": "Btch #"},
   "ST_SALES_ORDER_DET.EXPIRE_DATE": {"sql": "app_ui.lot_expiry(t.item_confg_id)", "label_a": "تاريخ الصلاحية", "label_e": "Exp Date", "type": "DATE"}
  },
  "columns": {
   "ST_SALES_ORDER.TRNS_TYPE_CODE": {"readonly_after_insert": true},
   "ST_SALES_ORDER.STORE_CODE": {"readonly_after_insert": true, "required": true},
   "ST_SALES_ORDER.CUSTOMER_CODE": {"required": true},
   "ST_SALES_ORDER.CLASS_CODE": {"widget": "SELECT", "lov": "select c.class_code || ' - ' || c.desc_a d, c.class_code r from ar_st_item_classes c order by c.class_code"},
   "ST_SALES_ORDER.PAYMENT_TYPE": {"widget": "SELECT", "lov": "select p.serial || ' - ' || p.type_name d, p.serial r from st_payment_terms p order by p.serial"},
   "ST_SALES_ORDER_DET.ITEM_CONFG_ID": {"widget": "POPUP", "cascade": "ITEM_CODE", "lov": "select c.item_confg_id || ' - ' || c.lot_number || ' - ' || to_char(c.expire_date, 'DD/MM/YYYY') d, c.item_confg_id r from st_item_confg c where c.item_code = :PAGE_ITEM_CODE order by c.expire_date, c.item_confg_id"}
  },
    "where": "TRNS_TYPE_CODE IN (SELECT T.TRNS_TYPE_CODE FROM ST_TRNS_TYPE T WHERE T.EFFECT = 7 AND T.TRNS_TYPE = 30) AND (NVL(:G_PASSWORD_NUMBER,0) = 0 OR TRNS_TYPE_CODE IN (SELECT TP.TRNS_TYPE_CODE FROM ST_TRNSTYPE_PASSWORD TP WHERE TP.FLAG = 1 AND TP.PASSWORD_NUMBER = :G_PASSWORD_NUMBER)) AND NVL(GET_SALES_PRIV(CUSTOMER_CODE, SALESMAN_CODE, SALESMAN_CODE, NVL(:G_PASSWORD_NUMBER,0)),0) != 0 AND DELETE_DATE IS NULL AND (NVL(:G_PASSWORD_NUMBER,0) = 0 OR NVL((SELECT U.OWNER_SALES_ORDER_ONLY FROM USERS U WHERE U.USERS_CODE = :G_USER_CODE),0) = 0 OR INSERT_USER = :G_USER_CODE)",
    "defaults": {
      "ST_SALES_ORDER.TRNS_TYPE_CODE": {
        "type": "SQL_QUERY",
        "value": "select app_rules_sa.first_type('SO') from dual"
      },
      "ST_SALES_ORDER.ORDER_DATE": {
        "type": "EXPRESSION",
        "value": "to_char(sysdate, 'DD/MM/YYYY')"
      },
      "ST_SALES_ORDER.APPROVED": {
        "type": "STATIC",
        "value": "0"
      },
      "ST_SALES_ORDER.APPROVED2": {
        "type": "STATIC",
        "value": "0"
      },
      "ST_SALES_ORDER.CLOSED": {
        "type": "STATIC",
        "value": "0"
      },
      "ST_SALES_ORDER.AUTO_DISC_INIT": {
        "type": "STATIC",
        "value": "1"
      }
    },
    "readonly": [
      "ST_SALES_ORDER.TRNS_SERIAL",
      "ST_SALES_ORDER.INVOICE_NUMBER",
      "ST_SALES_ORDER_DET.TAX_VALUE1",
      "ST_SALES_ORDER.CLOSED"
    ],
    "optional": [
      "ST_SALES_ORDER.STORE_CODE",
      "ST_SALES_ORDER_DET.ITEM_GROUP_CODE",
      "ST_SALES_ORDER_DET.UNIT_CODE",
      "ST_SALES_ORDER_DET.QUANTITY",
      "ST_SALES_ORDER_DET.BASIC_QTY"
    ],
    "row_rules": {
      "ST_SALES_ORDER": "app_rules_sa.so_mast_row(inserting, :new.trns_type_code, :new.trns_serial, :new.order_date, :new.store_code, :new.customer_code, :new.salesman_code, :new.currency_code, :new.currency_rate, :new.invoice_number, :new.approved, :old.approved, :new.approved_users_code, :new.approved_date, :new.approved2, :old.approved2, :new.approved2_users_code, :new.approved2_date, :new.closed, :new.auto_disc_init, :new.pay_term, :new.offer_expire_date);",
      "ST_SALES_ORDER_DET": "if :new.item_confg_id is null and not app_rules_sa.bypass then app_act_st.so_mark_auto_lot(:new.trns_type_code, :new.trns_serial, :new.serial); end if; app_rules_sa.so_det_row(inserting, :new.trns_type_code, :new.trns_serial, :new.serial, :new.item_group_code, :new.item_code, :old.item_code, :new.unit_code, :old.unit_code, :new.item_confg_id, :old.item_confg_id, :new.temp_quantity, :new.quantity, :new.bonus, :new.bonus_ratio, :new.extra_bonus, :new.extra_bonus_ratio, :new.basic_qty, :new.unit_price_curr, :new.unit_price, :new.disc1_ratio, :new.disc1_value, :new.disc2_ratio, :new.disc2_value, :new.disc3_ratio, :new.disc3_value, :new.auto_disc, :new.org_disc1_ratio, :new.org_disc2_ratio, :new.org_disc3_ratio, :new.org_bonus_ratio, :new.org_unit_price_curr, :new.org_extra_bonus_ratio, :new.org_class_code, :new.tax_code1, :new.tax_value1, :new.last_expire_date);"
    },
    "validations": [
      {
        "name": "قواعد أمر البيع والاعتماد",
        "when": "CREATE,SAVE",
        "plsql": "return app_rules_sa.so_validate(:REQUEST, :PAGE_ROWID, :PAGE_TRNS_TYPE_CODE, :PAGE_ORDER_DATE, :PAGE_STORE_CODE, :PAGE_CUSTOMER_CODE, :PAGE_SALESMAN_CODE, :PAGE_CURRENCY_CODE, :PAGE_CURRENCY_RATE, :PAGE_CLASS_CODE, :PAGE_RFQ, :PAGE_DOC_NO, :PAGE_APPROVED, :PAGE_APPROVED2, :PAGE_CLOSED, :PAGE_TOT_DISC1_RATIO, :PAGE_TOT_DISC1_VALUE, :PAGE_TOT_DISC2_RATIO, :PAGE_TOT_DISC2_VALUE, :PAGE_TOT_DISC3_RATIO, :PAGE_TOT_DISC3_VALUE);"
      }
    ],
    "after_save": [
      {
        "name": "خصومات وإغلاق أصناف أمر البيع",
        "when": "CREATE,SAVE",
        "plsql": "app_rules_sa.so_after_save(:REQUEST, :PAGE_ROWID);"
      },
      {
        "name": "توزيع الصنف على الشحنات حسب تاريخ الصلاحية (DEVIDE_CONFGS)",
        "when": "CREATE,SAVE",
        "plsql": "app_act_st.so_split_lots(:REQUEST, :PAGE_ROWID);"
      },
      {
        "name": "حذف أمر البيع: غير مسموح بعد عمل فاتورة مبيعات",
        "when": "DELETE",
        "plsql": "app_act_st.so_after_delete(:PAGE_TRNS_TYPE_CODE, :PAGE_TRNS_SERIAL);"
      }
    ],
    "warnings": [
      {
        "name": "حد الائتمان",
        "when": "SAVE",
        "plsql": "return app_act_st.so_warn_credit(:PAGE_ROWID, :PAGE_CUSTOMER_CODE, :PAGE_APPROVED);"
      },
      {
        "name": "تاريخ أمر العميل",
        "when": "CREATE,SAVE",
        "plsql": "return app_act_st.so_warn_po_date(:PAGE_ORDER_DATE, :PAGE_PO_CUST_DATE);"
      }
    ],
    "info": [
      {
        "name": "CREDIT_LIMIT",
        "label_a": "متبقى الإئتمان",
        "label_e": "Credit Limit",
        "sql": "select app_act_st.so_info('CREDIT_LIMIT', :PAGE_ROWID) from dual"
      },
      {
        "name": "BALANCE",
        "label_a": "الرصيد الجارى",
        "label_e": "Current Balance",
        "sql": "select app_act_st.so_info('BALANCE', :PAGE_ROWID) from dual"
      },
      {
        "name": "DAYS",
        "label_a": "عمر الفاتورة",
        "label_e": "Inv Limit",
        "sql": "select app_act_st.so_info('DAYS', :PAGE_ROWID) from dual"
      },
      {
        "name": "DAY_NO",
        "label_a": "السماح",
        "label_e": "Allowed",
        "sql": "select app_act_st.so_info('DAY_NO', :PAGE_ROWID) from dual"
      },
      {
        "name": "CREDIT_STATE",
        "label_a": "حالة الائتمان",
        "label_e": "Credit status",
        "sql": "select app_act_st.so_info('CREDIT_STATE', :PAGE_ROWID) from dual"
      },
      {
        "name": "NET",
        "label_a": "الإجمالي بعد الخصم والضريبة",
        "label_e": "Total Invoice Value After Vat & Disc.",
        "sql": "select app_act_st.so_info('NET', :PAGE_ROWID) from dual"
      },
      {
        "name": "TAX",
        "label_a": "إجمالي قيمة الضريبة",
        "label_e": "Tax Value",
        "sql": "select app_act_st.so_info('TAX', :PAGE_ROWID) from dual"
      },
      {
        "name": "ITEMS",
        "label_a": "الأصناف",
        "label_e": "Items",
        "sql": "select app_act_st.so_info('ITEMS', :PAGE_ROWID) from dual"
      },
      {
        "name": "AVAILABLE",
        "label_a": "متاح",
        "label_e": "Ava.",
        "sql": "select app_act_st.so_info('AVAILABLE', :PAGE_ROWID) from dual"
      },
      {
        "name": "UNAVAILABLE",
        "label_a": "غ متاح",
        "label_e": "UnAva.",
        "sql": "select app_act_st.so_info('UNAVAILABLE', :PAGE_ROWID) from dual"
      },
      {
        "name": "DIFF_POLICY",
        "label_a": "مخالف",
        "label_e": "Ov Disc",
        "sql": "select app_act_st.so_info('DIFF_POLICY', :PAGE_ROWID) from dual"
      },
      {
        "name": "SALES_LIMIT",
        "label_a": "تعدي الحد",
        "label_e": "Sls Lmt",
        "sql": "select app_act_st.so_info('SALES_LIMIT', :PAGE_ROWID) from dual"
      },
      {
        "name": "WIDE_PRICE",
        "label_a": "سعر الصنف أقل من سعر الجملة",
        "label_e": "Item price less than the wholesale price",
        "sql": "select app_act_st.so_info('WIDE_PRICE', :PAGE_ROWID) from dual"
      },
      {
        "name": "INVOICE",
        "label_a": "فاتورة المبيعات",
        "label_e": "Sales invoice",
        "sql": "select app_act_st.so_info('INVOICE', :PAGE_ROWID) from dual"
      }
    ]
  },
  "actions": [
    {
      "name": "CLOSE",
      "label_a": "إقفال",
      "label_e": "Close",
      "confirm_a": "هل انت متاكد من إقفال الحركة؟",
      "confirm_e": "Are you sure you want to close the transaction? ",
      "condition": "app_act_st.so_can('CLOSE', :PAGE_ROWID) = 'Y' and app_sec.can_page(:APP_PAGE_ID, 'U')",
      "call": "app_act_st.so_close(:PAGE_ROWID)",
      "message": "app_act_st.last_message",
      "success_a": "تم اقفال أمر البيع",
      "success_e": "Sales Order Closed",
      "icon": "fa-lock"
    },
    {
      "name": "REOPEN",
      "label_a": "إلغاء الاقفال",
      "label_e": "Unclose",
      "confirm_a": "هل انت متاكد من فتح الحركة؟",
      "confirm_e": "Are you sure you want ot open the transaction",
      "condition": "app_act_st.so_can('REOPEN', :PAGE_ROWID) = 'Y' and app_sec.can_page(:APP_PAGE_ID, 'U')",
      "call": "app_act_st.so_reopen(:PAGE_ROWID)",
      "message": "app_act_st.last_message",
      "success_a": "تم فتح أمر البيع",
      "success_e": "Sales Order opened",
      "icon": "fa-unlock"
    },
    {
      "name": "CANCEL_ORDER",
      "label_a": "إلغاء أمر البيع",
      "label_e": "Cancel order",
      "confirm_a": "هل تريد إلغاء أمر البيع؟",
      "confirm_e": "Cancel this sales order?",
      "condition": "app_act_st.so_can('CANCEL', :PAGE_ROWID) = 'Y' and app_sec.can_page(:APP_PAGE_ID, 'U')",
      "call": "app_act_st.so_cancel(:PAGE_ROWID, 0)",
      "message": "app_act_st.last_message",
      "success_a": "تم إلغاء أمر البيع",
      "success_e": "Sales Order Cancelled.",
      "icon": "fa-ban"
    },
    {
      "name": "ACTIVATE_ORDER",
      "label_a": "تنشيط أمر البيع",
      "label_e": "Activate order",
      "confirm_a": "هل تريد تنشيط أمر البيع؟",
      "confirm_e": "Activate this sales order?",
      "condition": "app_act_st.so_can('ACTIVATE', :PAGE_ROWID) = 'Y' and app_sec.can_page(:APP_PAGE_ID, 'U')",
      "call": "app_act_st.so_cancel(:PAGE_ROWID, 1)",
      "message": "app_act_st.last_message",
      "success_a": "تم تنشيط أمر البيع",
      "success_e": "Sales Order Activated.",
      "icon": "fa-check"
    }
  ],
 "links": [
  {"label_a": "ملف العملاء", "label_e": "Customers file", "form": "CUSTOMER", "icon": "fa-users"}
 ]
}
